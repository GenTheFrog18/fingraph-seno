# Copy only as a starting point for a managed backend host. Never commit the
# resulting `.env`; use the provider's secret/environment settings.
APP_ENV=production
DEMO_MODE=false
DEBUG=false
LOG_LEVEL=INFO
PROJECT_NAME=FinGraph QRIS API
API_VERSION=v1
ENABLE_API_DOCS=false
ENABLE_DEMO_ENDPOINTS=false
PUBLIC_REGISTRATION_ENABLED=false

# Example: fingraph-api.onrender.com,api.fingraph.id
TRUSTED_HOSTS=api.example.com
# Example Vercel production and preview origins, comma separated.
BACKEND_CORS_ORIGINS=https://example.vercel.app

DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DATABASE
POSTGRES_HOST=HOST
POSTGRES_PORT=5432
POSTGRES_DB=DATABASE
POSTGRES_USER=USER
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DATABASE_PASSWORD

NEO4J_URI=bolt://neo4j-host:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=REPLACE_WITH_STRONG_NEO4J_SECRET
NEO4J_REQUIRED=false
NEO4J_CONNECTION_TIMEOUT_SECONDS=3
NEO4J_MAX_RETRY_SECONDS=3

JWT_SECRET_KEY=REPLACE_WITH_OPENSSL_RANDOM_HEX_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
PJP_SIMULATOR_SECRET=REPLACE_WITH_DISABLED_SIMULATOR_SECRET
PJP_SIMULATOR_NAME=Disabled Simulator
PAYER_PSEUDONYM_KEY=REPLACE_WITH_OPENSSL_RANDOM_HEX_32
QRIS_DEMO_MODE=false
QRIS_WEBHOOK_TOLERANCE_SECONDS=300
QRIS_DEFAULT_CURRENCY=IDR

ML_ARTIFACT_DIR=/var/lib/fingraph/ml-artifacts
ML_ARTIFACT_SIGNING_KEY=REPLACE_WITH_OPENSSL_RANDOM_ARTIFACT_SIGNING_SECRET
AUTO_MIGRATE=false
AUTO_SEED=false
SEED_GRAPH_SYNC=false
UVICORN_WORKERS=2
